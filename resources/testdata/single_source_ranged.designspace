<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <!-- one source with ranged axes: --export builds an instance as a static font, though it doesn't sit on the source, as a single master is the same everywhere -->
  <axes>
    <axis tag="wght" name="Weight" minimum="100" default="400" maximum="900">
      <map input="100" output="10"/>
      <map input="400" output="40"/>
      <map input="900" output="90"/>
    </axis>
    <axis tag="wdth" name="Width" minimum="75" default="100" maximum="100"/>
  </axes>
  <sources>
    <source filename="WghtVar-Regular.ufo" name="Regular">
      <location>
        <dimension name="Weight" xvalue="40"/>
        <dimension name="Width" xvalue="100"/>
      </location>
    </source>
  </sources>
  <instances>
    <instance familyname="Single Source" stylename="Bold">
      <location>
        <dimension name="Weight" uservalue="700"/>
      </location>
    </instance>
  </instances>
</designspace>
