<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <!-- a sparse layer source is a master at another location: exporting the instance on the full source drops it and builds a static font -->
  <axes>
    <axis tag="wght" name="Weight" minimum="100" default="400" maximum="900">
      <map input="100" output="10"/>
      <map input="400" output="40"/>
      <map input="900" output="90"/>
    </axis>
    <axis tag="wdth" name="Width" minimum="75" default="100" maximum="100"/>
  </axes>
  <sources>
    <source filename="WghtVar-Regular.ufo" name="Regular">
      <location>
        <dimension name="Weight" xvalue="40"/>
        <dimension name="Width" xvalue="100"/>
      </location>
    </source>
    <source filename="WghtVar-Regular.ufo" name="Regular {600}" layer="{600}">
      <location>
        <dimension name="Weight" xvalue="60"/>
        <dimension name="Width" xvalue="100"/>
      </location>
    </source>
  </sources>
  <instances>
    <instance familyname="Single Source" stylename="Regular">
      <location>
        <dimension name="Weight" uservalue="400"/>
      </location>
    </instance>
  </instances>
</designspace>
