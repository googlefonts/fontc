<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <!-- one source with a rule: an instance outside the rule's range builds a static font without it, one inside is an error until fontc swaps the glyphs -->
  <axes>
    <axis tag="wght" name="Weight" minimum="400" default="400" maximum="700"/>
  </axes>
  <rules>
    <rule name="BRACKET.550.700">
      <conditionset>
        <condition name="Weight" minimum="550" maximum="700"/>
      </conditionset>
      <sub name="plus" with="bar"/>
    </rule>
  </rules>
  <sources>
    <source filename="WghtVar-Regular.ufo" name="Regular">
      <location>
        <dimension name="Weight" xvalue="400"/>
      </location>
    </source>
  </sources>
  <instances>
    <instance familyname="Single Source" stylename="Regular">
      <location>
        <dimension name="Weight" xvalue="400"/>
      </location>
    </instance>
    <instance familyname="Single Source" stylename="Bold">
      <location>
        <dimension name="Weight" xvalue="700"/>
      </location>
    </instance>
  </instances>
</designspace>
